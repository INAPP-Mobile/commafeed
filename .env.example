# Copy to .env when running locally; on Railway these are template variables.
# Use human-readable prose placeholders, never format-accurate fake secrets.

# Password for the auto-seeded admin account (username: admin).
COMMAFEED_ADMIN_PASSWORD=your-admin-password-here

# Fixed key encrypting login session cookies (min 16 chars). Keep this stable
# across redeploys or every login is lost on restart.
QUARKUS_HTTP_AUTH_SESSION_ENCRYPTION_KEY=your-session-encryption-key-here

# Optional upstream tunables (defaults shown):
# Port is set from Railway's PORT automatically; do not set this yourself.
# QUARKUS_HTTP_PORT=8082
# Allow subscribing to feeds on private/local addresses (default true is
# blocked to prevent SSRF; only disable if you trust every user).
# COMMAFEED_HTTP_CLIENT_BLOCK_LOCAL_ADDRESSES=true
# How often feeds are refreshed (default PT30M).
# COMMAFEED_FEED_REFRESH_INTERVAL=PT30M
# Allow open registration of new accounts (default false — admin adds users).
# COMMAFEED_USERS_ALLOW_REGISTRATIONS=false
